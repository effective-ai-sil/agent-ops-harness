{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/destructive-guard.cjs\"" }]
      },
      {
        "matcher": "Bash|Read|Write|Edit|MultiEdit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/secret-guard.cjs\"" }]
      },
      {
        "matcher": "Bash|mcp__.*",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/action-rules.cjs\"" }]
      }
    ]
  }
}
